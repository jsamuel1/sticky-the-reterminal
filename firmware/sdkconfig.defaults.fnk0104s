# Freenove FNK0104S overlay — layered on sdkconfig.defaults:
#   idf.py -B build-fnk0104s -DSDKCONFIG=build-fnk0104s/sdkconfig \
#          -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.fnk0104s" build
# (or tools/build_board.sh fnk0104s). firmware/build stays the reTerminal
# release input; this board never builds there.
CONFIG_TINY_BOARD_FNK0104S=y
# CONFIG_TINY_BOARD_RETERMINAL is not set

# Flash: 16 MB, JEDEC 0x18405e measured on the owner's unit (the schematic's
# W25X40 label is wrong). DIO 80 MHz = the vendor's own flash script.
# CONFIG_ESPTOOLPY_FLASHSIZE_32MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# PSRAM: ESP32-S3R8 = 8 MB octal in package (measured). Same as base.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console: the USB-C port is the S3's native USB-Serial-JTAG (no bridge chip;
# UART0 is only on the header pins). Boot log + the {json} bench line reader.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Internal RAM: colour boards spend it on LCD DMA strips and I2S rings, and a
# voice upload needs 60 KB of it free for TLS (tiny_upload pre-flight). With
# the stock 16 KB threshold every small malloc lands internal: measured
# 24 KB free at upload time on the FNK0104S. Mallocs over 512 B go to PSRAM
# first; explicit DMA/INTERNAL requests are unaffected.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
# NOT SPIRAM_TRY_ALLOCATE_WIFI_LWIP: on IDF 5.4 it forces 16 static Wi-Fi TX
# buffers and raises static RX 10 -> 16, ~1.6 KB each of INTERNAL DMA RAM
# held from Wi-Fi start. Measured on the FNK0104S: internal free at upload
# fell 24.4 KB -> 17.5 KB with it on. Dynamic TX buffers stay (allocated per
# packet, released after).
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# Internal RAM, round 2 (voice upload pre-flight still short at 55.8 KB idle
# after the PSRAM .bss move). Each figure below is a measured static D/IRAM
# delta on the fnk0104s image (idf.py size, IDF 5.4); BLE runtime cost is
# logged at boot as "ble beacon: ... internal -N B".
#
# Wi-Fi hot paths execute from flash instead of IRAM: -16.8 KB static.
# This board polls and uploads ~0.5 MB files; it does not need line-rate Wi-Fi.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
#
# BLE stays on, sized to what tiny_beacon + tiny_ble actually use: one
# advertising set, one passive scan, ONE catalog reader at a time (the
# beacon stops advertising on connect and resumes on disconnect), no bonding,
# no notify characteristics, legacy (non-5.0) advertising only. These pools
# are allocated when the controller/host start, so idf.py size shows 0; the
# boot log line shows the real saving.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=20
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=8
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=10
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=4
# CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT is not set
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
